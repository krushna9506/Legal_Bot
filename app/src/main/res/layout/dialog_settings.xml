<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ios_bubble_assistant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tag_statute" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:text="AI Provider &amp; API Configuration"
            android:textColor="@color/ios_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Choose your preferred engine or use the free offline knowledge base."
            android:textColor="@color/ios_text_secondary"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="Select AI Provider:"
            android:textColor="@color/ios_text_primary"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rgProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbGemini"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/ios_blue"
                android:checked="true"
                android:paddingVertical="4dp"
                android:text="Google Gemini (Free Tier: 15 req/min, 1M context)"
                android:textColor="@color/ios_text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbGroq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/ios_blue"
                android:paddingVertical="4dp"
                android:text="Groq Cloud (Free Fast Tier: Llama 3.3 70B)"
                android:textColor="@color/ios_text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbOpenAI"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/ios_blue"
                android:paddingVertical="4dp"
                android:text="OpenAI (GPT-4o / GPT-4o-mini)"
                android:textColor="@color/ios_text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbOffline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/ios_blue"
                android:paddingVertical="4dp"
                android:text="Built-in Offline Indian Legal DB (Zero Key Needed)"
                android:textColor="@color/ios_text_primary"
                android:textSize="13sp" />

        </RadioGroup>

        <!-- API Key Input Section -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApiKey"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Enter API Key"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/ios_blue"
            app:endIconMode="password_toggle"
            app:helperText="Stored securely on device. Never shared or embedded.">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/ios_text_primary"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Model ID / Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilModel"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Model ID (e.g. gemini-3.1-flash-lite)"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/ios_blue">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="gemini-3.1-flash-lite"
                android:textColor="@color/ios_text_primary"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvKeyHelperLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:paddingVertical="4dp"
            android:text="🔗 Get a 100% Free Gemini Key from Google AI Studio ➔"
            android:textColor="@color/ios_blue"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelSettings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="@color/ios_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSettings"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/ios_blue"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="20dp"
                android:text="Save &amp; Apply"
                android:textColor="@color/text_white"
                app:cornerRadius="20dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
