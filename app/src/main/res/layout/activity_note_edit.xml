<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ios_card"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/noteEditToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/ios_card"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/ios_text_primary"
            app:title="Legal Note"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:titleTextColor="@color/ios_text_primary">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="12dp">

                <ImageButton
                    android:id="@+id/btnDeleteNote"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_ios_pill"
                    android:contentDescription="Delete Note"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/error_red" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveNote"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/ios_blue"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="18dp"
                    android:text="Save"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    app:cornerRadius="19dp" />

            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Hairline Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:background="@color/ios_border" />

        <!-- AI Assistant Tools Strip -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ios_card"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiSummarize"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="@color/ios_blue_light"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="12dp"
                    android:text="✨ AI Summarize"
                    android:textColor="@color/ios_blue"
                    android:textSize="12sp"
                    app:cornerRadius="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiPolish"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/ios_blue_light"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="12dp"
                    android:text="⚖ Polish Legal Phrasing"
                    android:textColor="@color/ios_blue"
                    android:textSize="12sp"
                    app:cornerRadius="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiExtractTasks"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/legal_gold_light"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="12dp"
                    android:text="📅 Extract Deadlines"
                    android:textColor="@color/legal_gold_dark"
                    android:textSize="12sp"
                    app:cornerRadius="17dp" />

            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:background="@color/ios_border" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- AI Loading Indicator -->
    <ProgressBar
        android:id="@+id/pbNoteAiLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/ios_blue"
        android:visibility="gone" />

    <!-- Document Editor Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ios_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/ios_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <EditText
                    android:id="@+id/etNoteTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:hint="Case Title / Subject"
                    android:inputType="textCapWords"
                    android:textColor="@color/ios_text_primary"
                    android:textColorHint="@color/ios_text_tertiary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.6dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/ios_border" />

                <EditText
                    android:id="@+id/etNoteContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="Record case facts, statutory sections (BNS/BNSS/IPC), advocate observations, or client notes..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:lineSpacingMultiplier="1.3"
                    android:minLines="14"
                    android:textColor="@color/ios_text_primary"
                    android:textColorHint="@color/ios_text_tertiary"
                    android:textSize="14.5sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </ScrollView>

</LinearLayout>
