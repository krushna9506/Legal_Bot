<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingVertical="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_ios_bubble_assistant"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Header: Scale Icon + Provider Badge + Grounding Tag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Legal AI"
                android:src="@drawable/ic_balance_scale"
                app:tint="@color/ios_blue" />

            <TextView
                android:id="@+id/tvAssistantHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:text="Legal AI Counsel"
                android:textColor="@color/ios_text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGroundingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_statute"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="Grounded Citation"
                android:textColor="@color/statute_tag_text"
                android:textSize="9.5sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Dynamic Statute / Legal Reference Chips Container -->
        <LinearLayout
            android:id="@+id/layoutCitations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvStatuteTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_citation"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="BNS § 103 / IPC § 302"
                android:textColor="@color/citation_tag_text"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Step-by-Step Drafting / Loading State -->
        <LinearLayout
            android:id="@+id/layoutDraftingState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/pbDrafting"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateTint="@color/ios_blue" />

            <TextView
                android:id="@+id/tvDraftingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Researching BNS/BNSS statutes &amp; drafting analysis..."
                android:textColor="@color/ios_text_secondary"
                android:textSize="12.5sp" />

        </LinearLayout>

        <!-- Dynamic Formatted Lines Container for Line-by-Line Fade-in Animation -->
        <LinearLayout
            android:id="@+id/layoutMessageLines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- Fallback/Static Response Text (Hidden when layoutMessageLines is used) -->
        <TextView
            android:id="@+id/tvAssistantMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/ios_text_primary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Under Section 103 of the Bharatiya Nyaya Sanhita, 2023..." />

        <!-- Bottom Action Bar: Speak, Copy, Share, Timestamp -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSpeak"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Read Aloud"
                android:padding="6dp"
                android:src="@drawable/ic_volume"
                app:tint="@color/ios_text_secondary" />

            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Copy Text"
                android:padding="6dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/ios_text_secondary" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Share Draft"
                android:padding="6dp"
                android:src="@drawable/ic_share"
                app:tint="@color/ios_text_secondary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvAssistantTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ios_text_tertiary"
                android:textSize="10.5sp"
                tools:text="11:45 PM" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
