<resources>
    <!-- Base application theme. -->
    <style name="Theme.LegalAI" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_navy</item>
        <item name="colorPrimaryVariant">@color/primary_navy_variant</item>
        <item name="colorOnPrimary">@color/text_white</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/legal_gold</item>
        <item name="colorSecondaryVariant">@color/legal_gold_dark</item>
        <item name="colorOnSecondary">@color/primary_navy</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <item name="android:windowBackground">@color/surface_bg</item>
    </style>
</resources>
